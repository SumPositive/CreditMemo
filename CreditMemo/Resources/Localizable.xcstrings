    "card.help.name" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Register the name of a payment method that is debited from your account later. For PayPay, credit-linked use and top-ups to the PayPay balance are tracked; spending from the topped-up PayPay balance is not."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "後日、口座から引き落とされる決済手段の名称を登録します。PayPayならばクレジット連携の利用やPayPay残高へのチャージが決済対象になります。チャージしたPayPay残高の利用は対象外です。"
          }
