    "top.help.bankList" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse Abbuchungskonten. Einfache Namen genügen. Wechsle pro Konto zwischen offen und bezahlt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Register debit accounts. Simple names are fine. Switch between unpaid and paid per account."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引き落とし口座を登録します。簡単な名前でも大丈夫です。口座ごとに未払と引き落とし済みを切り替えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登记扣款账户。简单的名称即可。可按账户切换未付与已付。"
          }
        }
      }
    },
