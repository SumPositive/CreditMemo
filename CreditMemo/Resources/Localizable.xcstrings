    "card.edit.beginner.help" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib deiner Karte einen kurzen Spitznamen. Diese App verschlüsselt keine Daten, vermeide also sensible Angaben. Falls du Kartennummern angibst, sind nur die letzten 3 Stellen sicher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Give your card a short nickname. This app does not encrypt data, so avoid sensitive info. If you include card digits, only the last 3 are safe to store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クレジットカードの名称などを短い呼び名をつけてください。暗号化しませんので機密情報は入れず、カード番号を入れるならば下3桁までが安全です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为卡片起一个简短的昵称。本应用不加密数据，请勿填写敏感信息；如要填写卡号，仅后 3 位较为安全。"
          }
        }
      }
    },
    "card.edit.beginner.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzen Spitznamen für die Zahlungsmethode verwenden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a short payment method nickname"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "決済手段には短い呼び名を付けます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用简短的付款方式昵称"
          }
        }
      }
    },
    "card.edit.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erfasse Zahlungsmethoden, die später von deinem Konto abgebucht werden. Kredit- und Aufladungsarten werden unterstützt. Bei PayPay z. B. nur Aufladungen erfassen, nicht jede einzelne Nutzung. Sofort abgebuchte Zahlungen wie Debitkarten oder Bargeldaufladungen werden nicht unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Register payment methods that are debited from your account on a later date. Credit-type and charge-type payments are supported. For PayPay, for example, record only top-up payments; do not record each individual use. Payments that are debited immediately, such as debit cards or cash top-ups, are not supported."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "後日、口座から引き落とされる決済方法を登録してください。クレジット式やチャージ式の決済が対象です。例えばPayPayならばチャージ決済だけを記録します。毎回の利用は記録しません。デビットや現金チャージなど即時に引き落とされる決済は対象外です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请登记日后从账户扣款的付款方式。支持信用类和充值类付款。例如 PayPay 只记录充值付款，不记录每次使用。借记卡、现金充值等即时扣款的付款方式不在范围内。"
          }
        }
      }
    },
