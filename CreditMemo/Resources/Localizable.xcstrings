    "payment.beginner.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere diesen Eintrag als bezahlt, sobald du die Abbuchung bestätigt hast.***\n\nBei Bedarf kannst du diesen Eintrag jederzeit zurück auf offen setzen.**NON"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you confirm the debit, mark this item as paid.***\n\nIf needed, you can move this item back to unpaid at any time.**NON"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き落としを確認したら、この明細を引き落とし済みにします***\n\n必要ならいつでも、この明細を未払に戻せます**NON"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출금을 확인한 뒤 이 항목을 결제 완료로 표시합니다.***\n\n필요하면 언제든지 이 항목을 미결제로 되돌릴 수 있습니다.**NON"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認扣款後，將此條目標為已付。***\n\n如有需要，可隨時將此條目改回未付。**NON"
          }
        }
      }
    },
    "payment.beginner.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konten nach Bestätigung der Abbuchung als bezahlt markieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark accounts paid after confirming debit"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き落とし確認後に済みにします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출금 확인 후 결제 완료로 표시"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認扣款後再標為已付"
          }
        }
      }
    },
    "payment.beginner.line1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh eine Liste der Einträge mit anstehenden Abbuchungsterminen.\n\nNach Bestätigung der tatsächlichen Abbuchung die folgende Aktion ausführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See a list of items with upcoming debit dates.\n\nAfter confirming the actual debit, take the action below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き落とし日が近づいた状況を一覧できます\n\n実際の引き落としを確認して次の操作を行なってください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출금일이 다가온 항목 목록을 볼 수 있습니다.\n\n실제 출금을 확인한 뒤 아래 동작을 하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢視臨近扣款日的條目列表。\n\n確認實際扣款後，執行以下操作。"
          }
        }
      }
    },
    "payment.beginner.line2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Als bezahlt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark as paid"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き落とし済みにします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 완료로 표시"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "標為已付"
          }
        }
      }
    },
    "payment.beginner.line3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Eintrag, um ihn pro Konto, Methode oder Zahlung als bezahlt zu markieren oder das Abbuchungsdatum zu ändern.\n\nDu kannst außerdem jederzeit"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap an item to mark it paid by account, method, or payment, or to change its debit date.\n\nYou can also, at any time,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明細をタップして口座や手段、決済の単位で済みにすることや、引き落とし日を変更することが可能です\n\n必要ならいつでも"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목을 탭하면 계좌·수단·결제 단위로 결제 완료로 표시하거나 출금일을 변경할 수 있습니다.\n\n언제든지"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選條目，可按賬戶、方式或付款標為已付，或更改其扣款日期。\n\n你也可以隨時"
          }
        }
      }
    },
    "payment.beginner.line4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ihn zurück auf offen setzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "move it back to unpaid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未払に戻せます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미결제로 되돌릴 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將其改回未付。"
          }
        }
      }
    },
