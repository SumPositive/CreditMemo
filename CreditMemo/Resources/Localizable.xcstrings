    },
    "bank.beginner.line1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben rechts auf +, um ein Konto hinzuzufügen.\n\nTippe auf eine Zeile, um sie zu bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + at the top right to add an account.\n\nTap a row to edit its contents."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の＋から口座を追加できます\n\n明細をタップすると内容を編集できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 위 +에서 계좌를 추가할 수 있습니다.\n\n행을 탭하면 내용을 편집할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選右上角 + 新增賬戶。\n\n點選某行可編輯其內容。"
          }
        }
      }
    },
    "bank.beginner.line2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte eine Zeile gedrückt und ziehe sie nach oben oder unten, um die Reihenfolge zu ändern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold a row and drag it up or down to reorder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明細行を押しながら上下に動かすと移動して順序を変更できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행을 길게 눌러 위아래로 끌면 순서를 바꿀 수 있습니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
