    "card.beginner.statusSwipe": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische eine Zeile nach links, um Status und Neue Zahlung einzublenden. Status zeigt nur die Abbuchungen dieser Methode; Neue Zahlung startet einen Eintrag mit dieser Methode vorausgewählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe a row left to reveal Status and New Payment buttons. Status shows only this method’s debits; New Payment starts a record with this method preselected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明細行を左へスワイプすると次のアイコンが現れます。状況は手段で絞った引き落とし状況を表示し、新しい決済は新しい決済画面を開き、手段をセットします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행을 왼쪽으로 밀면 상태와 새 결제가 나타납니다. 상태는 이 수단의 출금만 표시하고, 새 결제는 이 수단을 미리 선택해 기록을 시작합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向左滑動某行可顯示“狀態”和“新建付款”。狀態僅顯示此方式的扣款；新建付款會以預選此方式開始一條記錄。"
          }
        }
      }
    },
