    "invoice.beginner.line1" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur diesen Eintrag als bezahlt markieren"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark only this item as paid"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この明細だけを済みにする"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅将此条目标为已付"
          }
        }
      }
    },
    "invoice.beginner.line2" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur diesen Eintrag zurück auf offen setzen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move only this item back to unpaid"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この明細だけを未払に戻す"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅将此条目改回未付"
          }
        }
      }
    },
    "invoice.beginner.line3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst den Status pro Konto, Methode oder Zahlung prüfen oder ändern.\n\nManchmal wird eine Zahlung, die den Stichtag verpasst, erst beim nächsten Mal abgebucht. In dem Fall kannst du hier das Abbuchungsdatum ändern.\n\nFolgende Aktionen sind pro Konto, Methode und Zahlung möglich:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can check or change the status per account, method, or payment.\n\nSometimes a payment that misses the cutoff is debited next time. In that case, you can change the debit date here.\n\nYou can perform the following actions by account, method, and payment:"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "口座/手段/決済の単位で状況の確認や変更ができます\n\n締切に間に合わなかった決済が次回に引き落とされるケースがあります。そのような時、ここから引き落とし日を変更できます\n\n口座と手段、決済の単位で次の操作がで\nきます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可按账户、方式或付款查看或更改状态。\n\n有时错过截止的付款会在下次扣款。此时可在此更改扣款日期。\n\n可按账户、方式和付款执行以下操作："
          }
        }
      }
    },
    "invoice.beginner.line4a" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右側の"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击右侧的 "
          }
        }
      }
    },
    "invoice.beginner.line4b" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " rechts; es wird zu "
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " on the right; it becomes "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "をタップすると"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " 会变为 "
          }
        }
      }
    },
    "invoice.beginner.line4c" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", und wichtige Felder werden gesperrt. Das beeinflusst die Verarbeitung nicht – nutze es als Bestätigungszeichen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " and key fields are locked. This does not affect processing — use it as a confirmation sign."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "に変わり重要項目がロックされます。処理に影響はありませんが、確認サインとしてご利用ください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "，重要字段将被锁定。这不影响处理——可作为确认标记使用。"
          }
        }
      }
    },
    "invoice.beginner.lockHelp" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf das Schloss-Symbol, um wichtige Felder wie Datum und Betrag zu sperren. Das beeinflusst Summen oder Klassifizierung nicht. Entspricht der Prüf-Funktion der alten App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap the lock icon to lock major fields such as the date and amount. It does not affect totals or classification. This is the same as the check feature from the old app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "鍵アイコンをタップすると日付や金額などの主要項目がロックされます。集計や分類の処理に影響はありません。旧アプリにあったチェック機能と同じです"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击锁定图标可锁定日期、金额等主要字段。不影响汇总或分类。与旧版应用的勾选功能相同。"
          }
        }
      }
    },
