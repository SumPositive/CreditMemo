    "invoice.bulkChangeDate.button": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle ändern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change all"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まとめて変更"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일괄 변경"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "批次更改"
          }
        }
      }
    },
    "invoice.bulkChangeDate.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere das Fälligkeitsdatum (Zahlungsdatum) aller aufgeführten Einträge auf einmal. Gesperrte Einträge werden nicht geändert. Bitte wähle ein Fälligkeitsdatum."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the due date (payment date) for all listed items at once. Locked items are not changed. Please pick a due date."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き落とし日（支払日）をまとめて変更します。ロックした明細は変更しません。引き落とし日を選択してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나열된 모든 항목의 출금일(결제일)을 한 번에 변경합니다. 잠긴 항목은 변경되지 않습니다. 출금일을 선택하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性更改所有列出條目的扣款日（付款日）。已鎖定的條目不會更改。請選擇扣款日。"
          }
        }
      }
    },
    "invoice.bulkChangeDate.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle ändern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change all"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まとめて変更"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일괄 변경"
          }
        },
