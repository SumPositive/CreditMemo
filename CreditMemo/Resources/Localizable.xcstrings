    "bank.edit.beginner.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deinem Konto einen kurzen Spitznamen. Diese App verschlüsselt keine Daten, vermeide also sensible Angaben. Falls du Kontonummern angibst, sind nur die letzten 3 Stellen sicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give your account a short nickname. This app does not encrypt data, so avoid sensitive info. If you include account digits, only the last 3 are safe to store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "銀行名など短い呼び名をつけてください。暗号化しませんので機密情報は入れず、口座番号を入れるならば下3桁までが安全です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계좌에 짧은 별칭을 붙이세요. 이 앱은 데이터를 암호화하지 않으므로 민감한 정보는 피하세요. 계좌번호를 넣는다면 마지막 3자리까지만 안전합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為賬戶起一個簡短的暱稱。本應用不加密資料，請勿填寫敏感資訊；如要填寫卡號，僅後 3 位較為安全。"
          }
        }
      }
    },
