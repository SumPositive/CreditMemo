    "record.dueDate.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wird automatisch aus deinen Eingaben bestimmt.\n\nDu kannst es durch Auswahl eines Datums ändern.\n\nSperren, um das Datum festzuhalten und weitere Änderungen zu verhindern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Determined automatically from your inputs.\n\nYou can change it by picking a date.\n\nLock to fix the date and prevent further changes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力に応じて自動的に決定します\n\n日付や金額をタップして変更できます\n\nロックすると固定化し、変更禁止になります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력에 따라 자동으로 정해집니다.\n\n날짜를 선택해 변경할 수 있습니다.\n\n잠그면 날짜가 고정되어 더 이상 변경되지 않습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據輸入自動確定。\n\n可選擇日期進行更改。\n\n鎖定可固定日期並防止再更改。"
          }
        }
      }
    },
    "record.dueDate.help.auto": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wird automatisch aus Nutzungsdatum und Zahlungsmethode bestimmt.\n\nBei „In 2 Raten“ wird der Eintrag in zwei geplante Abbuchungen aufgeteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Determined automatically from the use date and payment method.\n\nIf Pay in 2 is selected, the record is split into two scheduled debits."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用日と決済手段から自動的に支払日が表示されます\n\nN回払いを利用すると引き落としがN回に分かれます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용일과 결제 수단으로부터 자동으로 정해집니다.\n\n분할을 선택하면 출금이 여러 번으로 나뉩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據使用日和付款方式自動確定。\n\n選擇“分 2 次”時，記錄會拆分為兩次計劃扣款。"
          }
        }
      }
    },
    "record.dueDate.help.change": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kannst es durch Auswahl eines Datums ändern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "You can change it by picking a date"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付や金額をタップして変更できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜를 선택해 변경할 수 있습니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選擇日期進行更改"
          }
        }
      }
    },
    "record.dueDate.help.locked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fest. Nur manuelle Änderungen gelten. Zum Entsperren tippen – das Standarddatum wird automatisch wiederhergestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fixed. Only manual edits apply. Tap to unlock and the default date is restored automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動で支払日を変更できます。タップで解除すれば自動的に規定の支払日に戻ります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정됨. 수동 변경만 적용됩니다. 탭하여 해제하면 기본 날짜로 자동 복원됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已固定，僅手動更改有效。點選解鎖後會自動恢復預設日期。"
          }
        }
      }
    },
    "record.dueDate.help.unlocked": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wird automatisch auf das Standarddatum aktualisiert. Zum Sperren (manuell) tippen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Automatically updates to the default date. Tap to lock (manual)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動的に規定の支払日になります。タップでロック（手動）します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 날짜로 자동 업데이트됩니다. 탭하여 잠금(수동)합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會自動更新為預設日期。點選鎖定（手動）。"
