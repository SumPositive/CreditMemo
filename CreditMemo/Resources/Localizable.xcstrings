    "bank.beginner.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben rechts auf +, um ein Konto hinzuzufügen.\n\nTippe auf eine Zeile, um sie zu bearbeiten.\n\nHalte eine Zeile gedrückt und ziehe sie nach oben oder unten, um die Reihenfolge zu ändern.\n\nWische eine Zeile nach links, um das nächste Symbol einzublenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + at the top right to add an account.\n\nTap a row to edit its contents.\n\nPress and hold a row, then drag up or down to reorder.\n\nSwipe a row to the left to reveal the next icon."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の＋から口座を追加できます\n\n明細をタップすると内容を編集できます\n\n明細行を押しながら上下に動かすと移動して順序を変更できます\n\n明細行を左へスワイプすると次のアイコンが現れます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 위 +에서 계좌를 추가할 수 있습니다.\n\n행을 탭하면 내용을 편집할 수 있습니다.\n\n행을 길게 눌러 위아래로 끌면 순서를 바꿀 수 있습니다.\n\n행을 왼쪽으로 밀면 다음 아이콘이 나타납니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選右上角 + 新增賬戶。\n\n點選某行可編輯其內容。\n\n長按某行並上下拖動可調整順序。\n\n向左滑動某行可顯示下一個圖示。"
          }
        }
      }
    },
    "bank.beginner.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
