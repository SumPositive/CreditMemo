    "admob.packageMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Google Mobile Ads SDK ist noch nicht eingebunden. Die Werbe-Unterstützung steht nach der Integration zur Verfügung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Mobile Ads SDK is not linked yet. Ad support will be available after integration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Mobile Ads SDK が未導入です。導入後に広告応援を利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Mobile Ads SDK가 아직 연동되지 않았습니다. 연동 후 광고 후원을 이용할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未接入 Google Mobile Ads SDK。接入後即可使用廣告支援。"
          }
        }
      }
    },
    "alert.deleteConfirm.bank.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion kann nicht rückgängig gemacht werden. Der Zahlungsverlauf wird nicht gelöscht; das Konto wird nur auf „Nicht festgelegt“ gesetzt. Du kannst es später erneut festlegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action can't be undone. Payment history will not be deleted; the account will simply be set to Not Set. You can set it again later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません。決済履歴は消えません。口座が未設定に変わるだけです。改めて設定することが可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 되돌릴 수 없습니다. 결제 내역은 삭제되지 않으며, 계좌가 미설정으로 바뀔 뿐입니다. 나중에 다시 설정할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作無法撤銷。付款記錄不會被刪除，賬戶只會變為“未設定”。之後可重新設定。"
          }
        }
      }
    },
