    "migration.legacy.failed.message" : {
      "comment" : "Message shown when CoreData migration fails. User can skip (retry next launch) or discard legacy data.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alte App-Daten konnten nicht gelesen werden. Du kannst vorerst überspringen – die Migration wird beim nächsten Start erneut versucht. Oder verwirf die alten Daten und beginne neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't read old app data. You can skip for now — migration will retry on next launch. Or discard the old data to start fresh."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旧アプリのデータ読み出しに失敗しました。スキップすると次回起動時に再試行します。旧データを使わない場合は「旧データを破棄して新しく始める」を選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取旧版应用数据。可暂时跳过——下次启动会再次尝试迁移。或放弃旧数据，重新开始。"
          }
        }
      }
    },
