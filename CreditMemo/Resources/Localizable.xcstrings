    "migration.legacy.discard": {
      "comment": "A button label that, when tapped, will discard the user's legacy data and start a new migration process.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neu beginnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Fresh"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旧データを破棄して新しく始める"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로 시작"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新開始"
          }
        }
      }
    },
    "migration.legacy.failed.message": {
      "comment": "Message shown when CoreData migration fails. User can skip (retry next launch) or discard legacy data.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alte App-Daten konnten nicht gelesen werden. Du kannst vorerst überspringen – die Migration wird beim nächsten Start erneut versucht. Oder verwirf die alten Daten und beginne neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't read old app data. You can skip for now — migration will retry on next launch. Or discard the old data to start fresh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "旧アプリのデータ読み出しに失敗しました。スキップすると次回起動時に再試行します。旧データを使わない場合は「旧データを破棄して新しく始める」を選んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 앱 데이터를 읽지 못했습니다. 지금은 건너뛸 수 있으며 다음 실행 시 다시 시도합니다. 또는 이전 데이터를 버리고 새로 시작하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取舊版應用資料。可暫時跳過——下次啟動會再次嘗試遷移。或放棄舊資料，重新開始。"
          }
        }
      }
    },
    "migration.legacy.skip": {
      "comment": "Button label to skip migration and retry on next launch.",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überspringen (später)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip (Retry Next Launch)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
