    "settings.help.afterSave" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle, was nach dem Speichern einer neuen Zahlung passiert. Für Eintrag-nach-Eintrag nutze Fortlaufende Eingabe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose what happens after saving a new payment. Use Continuous Entry for back-to-back entries."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい決済を保存した後の画面遷移を選べます。連続して入力するなら「連続入力」が便利です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择保存新付款后的行为。连续录入时使用连续输入。"
          }
        }
      }
    },
    "settings.help.autoOpenAmountPad" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ist der Betrag einer neuen Zahlung 0, öffnet sich das Tastenfeld automatisch.\n\nSchließt du das Tastenfeld, während der Betrag noch 0 ist, wird auch der Bildschirm für die neue Zahlung geschlossen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the amount of a new payment is 0, the keypad opens automatically.\n\nClosing the keypad while the amount is still 0 also closes the new payment screen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい決済の金額が0ならばテンキーが自動的に開きます\n\n0のままテンキーを閉じると新しい決済画面も閉じます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新付款金额为 0 时，数字键盘会自动打开。\n\n金额仍为 0 时关闭键盘，也会关闭新付款界面。"
          }
        }
      }
    },
    "settings.help.enableInstallment" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erfasse eine in mehrere Raten (1–12) aufgeteilte Zahlung. Die Beträge werden standardmäßig gleichmäßig verteilt, und du kannst jede Rate manuell anpassen.\n\nIst dies aus, wird die Ratenzahlung für neue Einträge ausgeblendet. Vorhandene Einträge bleiben gültig.\n\nFür Bonus- oder Sonderzahlungstermine das Abbuchungsdatum manuell ändern. CrediMemo berechnet weder Zinsen noch Gebühren, nutze dies also nur für zins- und gebührenfreie Pläne."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Record a payment split into several installments (1–12). Amounts are divided evenly by default, and you can adjust each one manually.\n\nTurning this off hides installments for new records. Existing installment records stay valid.\n\nFor bonus or special payment dates, change the debit date manually. CrediMemo does not calculate interest or fees, so use this only for interest-free, fee-free plans."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支払を複数回に分けて記録できます（1〜12回）。金額は自動で均等配分し、各回を手動で調整することもできます\n\nOFFにすると新しい決済で分割払いを選べなくなります。すでに保存した分割払いは変わらず有効です\n\nボーナス払いは引き落とし日を手動で変更してください。利息や手数料は計算しませんので、無利息・手数料無料の範囲でご利用ください。利息や手数料を含めた金額にすれば使えると思いますが想定外です"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "记录拆分为多期（1–12 期）的付款。金额默认平均分配，也可手动调整每一期。\n\n关闭后，新记录将不显示分期。已有的分期记录仍然有效。\n\n奖金或特殊付款日请手动更改扣款日期。CrediMemo 不计算利息或手续费，请仅用于无息无手续费的计划。"
          }
        }
      }
    },
    "settings.help.enableVoiceInput" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An: Betrag und Label eines neuen Eintrags per Sprache eingeben.\n\nNoch eine Weile im [β]-Prototyp-Feinschliff."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On: Use your voice to enter the amount and label of a new record.\n\nStill in [β] prototype tuning for a while."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ON：音声により新しい決済が入力できます\n\n「Hey Siri クレメモで音声入力」と言えば、音声入力が始まります"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启：可用语音输入新记录的金额和标签。\n\n仍处于 [β] 原型调整阶段一段时间。"
          }
        }
      }
    },
    "settings.help.export" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile alle Einträge und Stammdaten als JSON-Datei. Auch für Backups praktisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share all records and master data as a JSON file. It's also handy for backups."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力された全データをファイル(JSON)で共有できます。バックアップのためにも活用してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将所有记录和主数据共享为 JSON 文件。也便于备份。"
          }
        }
      }
    },
    "settings.help.fontScale" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soll sehbehindertenfreundlich sein.\n\nAuto: Folgt deinen iOS-Einstellungen für größeren Text.\n\nStandard: Die eigene Standardgröße der App.\n\nGroß: Etwa 1,5× Standard.\n\nSehr groß: Etwa 2× Standard.\n\nAb „Sehr groß“ können manche Layouts noch brechen. Bei Problemen bitte melden, wir bemühen uns."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aiming to be low-vision friendly.\n\nAuto: Follows your iOS Larger Text settings.\n\nStandard: The app's own standard size.\n\nLarge: About 1.5× Standard.\n\nX-Large: About 2× Standard.\n\nAt X-Large or beyond, some layouts may still break. If you run into problems, please report them and we'll do our best to address them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ローガンフリーを目指します\n\n自動：システム設定のさらに大きな文字に対応します\n\n標準：アプリ独自の標準サイズ\n\n　大：標準の1.5倍くらいになります\n\n特大：標準の2倍くらいになります\n\n特大サイズくらいになると一部崩れるケースが残っています。どうしても困る場合は報告して頂ければ、できる限り対応したいと思っています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "力求对低视力友好。\n\n自动：跟随你的 iOS“更大字体”设置。\n\n标准：应用自身的标准大小。\n\n大：约为标准的 1.5 倍。\n\n特大：约为标准的 2 倍。\n\n在特大及以上，部分布局仍可能错位。如遇问题请反馈，我们会尽力处理。"
          }
        }
      }
    },
    "settings.help.import" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importiere eine exportierte JSON-Datei. Erneutes Importieren derselben Datei aktualisiert ohne Duplikate."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import an exported JSON file. Importing the same file again updates it without duplicates."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エキスポートしたファイル(JSON)を読み込みます。同じファイルを読み込んでも重複せずに上書きします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入已导出的 JSON 文件。再次导入同一文件会更新且不重复。"
          }
        }
      }
    },
    "settings.help.openAddOnActive" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, öffnet sich bei jeder Rückkehr zur App automatisch der Bildschirm für die neue Zahlung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, opens the new payment screen automatically each time you return to the app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにするとアプリを再表示したとき、自動的に新しい決済入力画面を開きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用后，每次返回应用时会自动打开新付款界面。"
          }
        }
      }
    },
    "settings.help.paymentWindow" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzahl der Tage im Abbuchungsstatus-Bildschirm. 7 Tage zeigt z. B. Summen, die innerhalb von 7 Tagen ab heute fällig sind. Nutze dies zur Vorbereitung der Mittel."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Number of days shown in the Debit Status screen. For example, 7 days shows totals due within 7 days from today. Use this as a reference for preparing funds."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「引き落とし状況」画面に表示する引き落とし合計の集計日数です。例えば7日にすると、今日から7日以内の引き落とし合計を表示します。資金準備の参考にしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扣款状态界面显示的天数。例如设为 7 天，会显示今天起 7 天内到期的合计。可作为备款参考。"
          }
        }
      }
    },
    "settings.help.retention" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viele Daten können das Tempo verlangsamen. Selbst 15 Jahre sollten funktionieren, aber etwa 3 Jahre passen besser zu dieser App."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too much data may slow things down. Even 15 years should work, but about 3 years fits this app better."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データが溜まりすぎると動作が遅くなる可能性があります。想定では15年でも大丈夫ですが、このアプリの目的では3年くらいが適切であると考えています。適時整理して3年分くらいでご利用ください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据过多可能变慢。即使 15 年也应可用，但约 3 年更适合本应用。"
          }
        }
      }
    },
    "settings.help.shareVoiceInputDiagnostics" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile anonyme Diagnosen zur Nutzung der Spracheingabe und zu Erkennungsfehlern.\n\nWenn aktiviert, können auch kurze, nicht zuordenbare Methoden-Begriffe als Verbesserungshinweise gesendet werden. Beträge, Labels und andere Zahlungsdetails werden nicht gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share anonymous diagnostics about voice input usage and recognition failures.\n\nWhen enabled, short payment-method phrases that could not be matched may also be sent as improvement hints. Amounts, labels, and other payment details are not sent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声入力の利用状況や認識失敗を匿名診断として共有します\n\nON の場合、手段の認識に使えなかった短い呼び方も改善ヒントとして送信します。金額やラベルなどの決済内容は送信しません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享有关语音输入使用情况和识别失败的匿名诊断。\n\n启用后，无法匹配的简短付款方式说法也可能作为改进提示发送。金额、标签等付款详情不会发送。"
          }
        }
      }
    },
    "settings.help.shiftDueDateOffHoliday" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fällt das berechnete Abbuchungsdatum auf ein Wochenende oder einen japanischen Feiertag, wird es auf den nächsten Werktag verschoben.\n\nGilt nur für Karten mit Abrechnungstag/Zahlungstag."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the calculated debit date falls on a weekend or Japanese public holiday, it is shifted to the next business day.\n\nApplies only to closing-day / payment-day cards."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引き落とし日が土日祝日に当たる場合、翌営業日へ繰り下げます\n\n締日/支払日型の決済手段にのみ適用します"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若计算出的扣款日落在周末或日本法定假日，则顺延至下一个工作日。\n\n仅适用于结算日/付款日类型的卡片。"
          }
        }
      }
    },
    "settings.help.userLevel" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anfänger zeigt Hinweise und Hilfe. Experte blendet sie aus. Wechsle zu Experte, sobald du den Ablauf beherrschst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginner shows hints and help. Expert hides them. Switch to Expert once you're comfortable with the flow."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初心者にはヒントやヘルプ表示します。達人になれば消えます。使い慣れて流れが分かってきたら、達人に切り替えてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新手会显示提示和帮助。专家会隐藏它们。熟悉流程后可切换为专家。"
          }
        }
      }
    },
