    "support.tip.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Unterstützung hilft, die Entwicklung fortzuführen. Bitte unterstütze nur in einem für dich angenehmen Rahmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your support helps keep development going. Please support only within a comfortable range."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開発を続ける励みになります。無理のない範囲で応援していただけるとうれしいです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러분의 후원이 개발을 이어가는 힘이 됩니다. 무리하지 않는 범위에서 응원해 주시면 감사하겠습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的支援是我們持續開發的動力。請在力所能及的範圍內支援。"
          }
        }
      }
    },
