    "settings.hint.paymentWindow": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Summen-Zeitraum für Abbuchungsstatus wählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the total window for Debit Status"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き落とし状況の集計期間を選びます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출금 상태의 합계 기간을 선택"
          }
        },
        "zh-Hant": {
