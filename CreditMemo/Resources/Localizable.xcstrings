    "top.beginner.guide": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starte mit „Neue Zahlung“.\n\nDu kannst nur mit dem Betrag speichern.\n\nFehlende Angaben lassen sich später ergänzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with \"New Payment\".\n\nYou can save with just the amount.\n\nMissing info can be filled in later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずは「新しい決済」から始めてください\n\n金額だけでも保存できます\n\n足りない情報はあとから直せます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 ‘새 결제’부터 시작하세요.\n\n금액만으로도 저장할 수 있습니다.\n\n부족한 정보는 나중에 채울 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先從“新建付款”開始。\n\n僅憑金額即可儲存。\n\n缺失的資訊可稍後補充。"
          }
        }
      }
    },
