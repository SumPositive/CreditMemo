    "record.help.label" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Label erscheint in Listen. Füge einen kurzen Hinweis wie Geschäft oder Zweck hinzu. Du kannst es später ändern oder unten eines auswählen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This label shows in lists. Add a short clue like a shop or purpose. You can change it later or pick one below."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一覧で目印になるラベルです。店名や目的など、あとで分かる短い言葉を入れてください。あとで変更できます。下の候補から選ぶこともできます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此标签会显示在列表中。请填写店名或用途等简短提示。之后可更改，或从下方选择。"
          }
        }
      }
    },
    "record.help.repeat" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird diese Zahlung als bezahlt markiert, wird automatisch eine neue Zahlung für den nächsten Monat oder das gewählte Intervall hinzugefügt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When this payment is marked paid, a new payment is added automatically for the next month or the selected interval."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この決済が引き落とし済みになった時、利用日を翌月などの指定日にした新しい決済を自動追加します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当此付款标为已付时，会自动为下个月或所选间隔添加一条新付款。"
          }
        }
      }
    },
    "record.help.tag" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst mehrere Tags wählen. Tags lassen sich später ändern oder ergänzen. Mit Tags werden Tag-Listen und Summen verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can pick more than one tag. You can change or add tags later. Tags make tag lists and totals available."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タグは複数選べます。あとで変更や追加もできます。タグを付けると、タグ別の一覧や集計が使えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可选择多个标签，之后也可更改或添加。添加标签后，可使用按标签的列表和汇总。"
          }
        }
      }
    },
    "record.list.beginner.guide" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte Zahlungen hier korrigieren.\n\nSchalte den Filter auf „Mit Lücken“, um nur Zahlungen mit fehlenden Angaben zu zeigen.\n\nDu kannst einen Eintrag auch durch Wischen kopieren. Einfach Betrag eingeben und speichern; ohne Betrag verschwindet er automatisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fix saved payments here.\n\nSwitch the filter to \"Incomplete\" to show only payments with missing info.\n\nYou can also swipe an item to copy it. Just enter the amount and save; if no amount is entered, it disappears automatically."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存後の修正はここで行います\n\nフィルターを【未入力あり】にすれば未入力や未選択が残っている決済が表示されます\n\n明細をスワイプしてコピーできます\n金額を入れて保存するだけ、金額を入れなければ自動で消えます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在此修正已保存的付款。\n\n将筛选切换为“有未填”可仅显示信息缺失的付款。\n\n也可滑动条目进行复制。只需输入金额并保存；未输入金额会自动消失。"
          }
        }
      }
    },
    "record.list.beginner.guide.leading" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte Zahlungen hier korrigieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fix saved payments here."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存後の修正はここで行います"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
