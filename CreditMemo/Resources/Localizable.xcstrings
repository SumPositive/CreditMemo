        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 위 +에서 결제 수단을 추가할 수 있습니다.\n\n행을 탭하면 내용을 편집할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選右上角 + 新增付款方式。\n\n點選某行可編輯其內容。"
          }
        }
      }
    },
