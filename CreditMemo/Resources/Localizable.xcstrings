      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can check or change the status per account, method, or payment.\n\nSometimes a payment that misses the cutoff is debited next time. In that case, you can change the debit date here.\n\nYou can perform the following actions by account, method, and payment:"
