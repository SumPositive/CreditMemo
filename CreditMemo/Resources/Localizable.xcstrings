    "record.beginner.guide": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst den Betrag eingeben und speichern.\n\nDen Rest kannst du später ergänzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the amount first and save.\n\nYou can fill in the rest later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずは金額を入れて保存してください\n\nその他はあとから直せます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 금액을 입력하고 저장하세요.\n\n나머지는 나중에 채울 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先輸入金額並儲存。\n\n其餘可稍後補充。"
          }
        }
      }
    },
    "record.beginner.guide.draft": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald Betrag und Zahlungsmethode festgelegt sind, kannst du speichern.\n\nDen Rest kannst du später ergänzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can save once the amount and payment method are set.\n\nYou can fill in the rest later."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金額と決済手段が決まれば保存できます\n\nその他はあとから直せます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금액과 결제 수단이 정해지면 저장할 수 있습니다.\n\n나머지는 나중에 채울 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金額和付款方式確定後即可儲存。\n\n其餘可稍後補充。"
          }
        }
      }
    },
    "record.beginner.guide.edit": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls Zahlungsmethode oder Abbuchungskonto nicht ausgewählt sind, wähle sie und speichere. Wenn du Zeit hast, nutze auch Labels und Tags."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If payment method or debit account is unselected, choose them and save. If you have time, also use labels and tags."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "決済手段と引き落とし口座に未選択があれば、選択して保存してください。余裕があれば決済ラベルやタグも活用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 수단이나 출금 계좌가 미선택이면 선택 후 저장하세요. 여유가 있으면 라벨과 태그도 활용하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若付款方式或扣款賬戶未選擇，請選擇後儲存。有時間也可使用標籤和標記。"
          }
        }
      }
    },
    "record.beginner.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst nur mit dem Betrag starten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can start with amount only"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずは金額だけでも保存できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "금액만으로도 시작할 수 있습니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可僅憑金額開始"
          }
        }
