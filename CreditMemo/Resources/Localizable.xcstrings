        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 點選可標為已付。"
          }
        }
      }
    },
    "top.help.paymentList.line4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Einträge jederzeit auf Offen zurücksetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can move items back to Unpaid anytime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要ならいつでも未払に戻せます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목은 언제든지 미결제로 되돌릴 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可隨時將條目改回未付。"
          }
        }
      }
    },
    "top.help.recordList": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neueste zuerst. Zum Bearbeiten tippen. Du kannst auch nur Zahlungen mit fehlenden Feldern anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown newest first. Tap to edit. You can also view only payments with missing fields."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい順に表示されます。タップして編集できます。不足項目のある決済だけを見ることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신순으로 표시됩니다. 탭하여 편집합니다. 항목이 빠진 결제만 볼 수도 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按最新優先顯示。點選可編輯。也可僅檢視欄位缺失的付款。"
          }
        }
      }
    },
    "top.help.settings": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle die Benutzerstufe auf Experte, um diese Beschreibungen auszublenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set User Level to Expert to hide these descriptions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザレベルを達人にすると、この説明文が消えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 수준을 숙련자로 설정하면 이 설명이 사라집니다."
