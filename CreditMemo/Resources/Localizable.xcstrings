    "invoice.beginner.addPayment": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neuen Eintrag hinzufügen.\nDu kannst einen Eintrag auch durch Wischen kopieren.\nEinfach Betrag eingeben und speichern; ohne Betrag verschwindet er automatisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a new item.\nYou can also swipe an item to copy it.\nJust enter the amount and save; if no amount is entered, it disappears automatically."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい明細を追加します\n明細をスワイプしてコピーもできます\n金額を入れて保存するだけ、金額を入れなければ自動で消えます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 항목을 추가합니다.\n항목을 밀어서 복사할 수도 있습니다.\n금액을 입력하고 저장하기만 하면 됩니다. 금액을 입력하지 않으면 자동으로 사라집니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增新條目。\n也可滑動條目進行復制。\n只需輸入金額並儲存；未輸入金額會自動消失。"
          }
        }
      }
    },
    "invoice.beginner.detail": {
      "comment": "未使用",
      "extractionState": "manual"
    },
    "invoice.beginner.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Status pro Eintrag prüfen oder ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check or change details per item."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細に状況の確認や変更ができます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목별로 상태를 확인하거나 변경할 수 있습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可按條目檢視或更改狀態。"
          }
        }
      }
    },
    "invoice.beginner.line1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur diesen Eintrag als bezahlt markieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark only this item as paid"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この明細だけを済みにする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목만 결제 완료로 표시"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅將此條目標為已付"
          }
        }
      }
    },
    "invoice.beginner.line2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur diesen Eintrag zurück auf offen setzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move only this item back to unpaid"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この明細だけを未払に戻す"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목만 미결제로 되돌리기"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅將此條目改回未付"
          }
        }
      }
    },
    "invoice.beginner.line3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst den Status pro Konto, Methode oder Zahlung prüfen oder ändern.\n\nManchmal wird eine Zahlung, die den Stichtag verpasst, erst beim nächsten Mal abgebucht. In dem Fall kannst du hier das Abbuchungsdatum ändern.\n\nFolgende Aktionen sind pro Konto, Methode und Zahlung möglich:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can check or change the status per account, method, or payment.\n\nSometimes a payment that misses the cutoff is debited next time. In that case, you can change the debit date here.\n\nYou can perform the following actions by account, method, and payment:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "口座/手段/決済の単位で状況の確認や変更ができます\n\n締切に間に合わなかった決済が次回に引き落とされるケースがあります。そのような時、ここから引き落とし日を変更できます\n\n口座と手段、決済の単位で次の操作がで\nきます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계좌·수단·결제 단위로 상태를 확인하거나 변경할 수 있습니다.\n\n마감에 늦은 결제가 다음 번에 출금되는 경우가 있습니다. 그럴 때 여기서 출금일을 변경할 수 있습니다.\n\n계좌·수단·결제 단위로 다음 동작을 할 수 있습니다:"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可按賬戶、方式或付款檢視或更改狀態。\n\n有時錯過截止的付款會在下次扣款。此時可在此更改扣款日期。\n\n可按賬戶、方式和付款執行以下操作："
          }
        }
      }
    },
    "invoice.beginner.line4a": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右側の"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽의 "
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選右側的 "
          }
        }
      }
    },
    "invoice.beginner.line4b": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " rechts; es wird zu "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " on the right; it becomes "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "をタップすると"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 을(를) 탭하면 "
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 會變為 "
          }
        }
      }
    },
    "invoice.beginner.line4c": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ", und wichtige Felder werden gesperrt. Das beeinflusst die Verarbeitung nicht – nutze es als Bestätigungszeichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " and key fields are locked. This does not affect processing — use it as a confirmation sign."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "に変わり重要項目がロックされます。処理に影響はありませんが、確認サインとしてご利用ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 로 바뀌고 주요 항목이 잠깁니다. 처리에는 영향이 없으니 확인 표시로 사용하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "，重要欄位將被鎖定。這不影響處理——可作為確認標記使用。"
          }
        }
      }
    },
    "invoice.beginner.lockHelp": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf das Schloss-Symbol, um wichtige Felder wie Datum und Betrag zu sperren. Das beeinflusst Summen oder Klassifizierung nicht. Entspricht der Prüf-Funktion der alten App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the lock icon to lock major fields such as the date and amount. It does not affect totals or classification. This is the same as the check feature from the old app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵アイコンをタップすると日付や金額などの主要項目がロックされます。集計や分類の処理に影響はありません。旧アプリにあったチェック機能と同じです"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠금 아이콘을 탭하면 날짜·금액 등 주요 항목이 잠깁니다. 집계나 분류에는 영향이 없습니다. 이전 앱의 체크 기능과 같습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選鎖定圖示可鎖定日期、金額等主要欄位。不影響彙總或分類。與舊版應用的勾選功能相同。"
          }
        }
      }
    },
    "invoice.beginner.lockToggle": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die wichtigen Felder dieses Eintrags sperren (Betrag/Nutzungsdatum/Methode/Abbuchungsdatum)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock only the major fields of this item (amount, use date, method, debit date)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この明細の主要項目（金額/利用日/手段/支払日）だけをロックする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목의 주요 항목(금액/사용일/수단/출금일)만 잠급니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅鎖定此條目的主要欄位（金額/使用日/方式/扣款日）"
          }
        }
      }
    },
    "invoice.beginner.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden Eintrag bearbeiten und bestätigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit and Confirm Each Item"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明細ごとに編集と確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목별 편집·확인"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
