    "top.help.tagList": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst pro Zahlung mehrere Tags vergeben. Mit Tags kannst du nach Tag auflisten und zusammenfassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
