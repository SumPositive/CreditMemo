    },
    "card.beginner.detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe oben rechts auf +, um eine neue Zahlungsmethode hinzuzufügen.\n\nHalte eine Zeile gedrückt und ziehe sie nach oben oder unten.\n\nWische eine Zeile nach links, um Status und Neue Zahlung einzublenden. Status zeigt nur die Abbuchungen dieser Methode; Neue Zahlung startet einen Eintrag mit dieser Methode vorausgewählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap + in the top right to add a new payment method.\n\nPress and hold a row to drag it up or down.\n\nSwipe a row left to reveal Status and New Payment buttons. Status shows only this method’s debits; New Payment starts a record with this method preselected."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右上の＋から決済手段を追加できます\n\n明細行を押しながら上下に動かすと移動して順序を変更できます\n\n明細行を左へスワイプすると次のアイコンが現れます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击右上角 + 添加新的付款方式。\n\n长按某行并上下拖动。\n\n向左滑动某行可显示“状态”和“新建付款”。状态仅显示此方式的扣款；新建付款会以预选此方式开始一条记录。"
          }
        }
      }
    },
    "card.beginner.hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahlungsmethoden oben rechts über + hinzufügen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add payment methods from + in the top right"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右上の＋から決済手段を追加できます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从右上角 + 添加付款方式"
          }
        }
      }
    },
