          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the filter to Incomplete to show only payments with missing info."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フィルターを【未入力あり】にすれば未入力や未選択が残っている決済が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필터를 ‘미입력 있음’으로 설정하면 정보가 빠진 결제만 표시됩니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將篩選設為“有未填”可僅顯示資訊缺失的付款。"
          }
        }
      }
    },
