    "card.field.closingDay.enHelp": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgaben nach diesem Tag werden auf den nächsten Monat übertragen. Ohne Angabe entspricht er dem Zahlungstag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spending after this day rolls over to the next month. If not set, it matches the payment day."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日以降の利用は翌月に繰り越します。未設定ならば支払日と同じになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 날 이후의 사용은 다음 달로 이월됩니다. 미설정이면 결제일과 같습니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此日之後的消費順延至下月。未設定時與付款日相同。"
