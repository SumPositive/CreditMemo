    "top.help.paymentList.line3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " tippen, um als Bezahlt zu markieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " tap to mark as Paid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "をタップして引き落とし済みにします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " 탭하여 결제 완료로 표시합니다."
          }
