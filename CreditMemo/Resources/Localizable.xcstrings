    "retention.prompt.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlungseinträge älter als 3 Jahre löschen?\nDas kann nicht rückgängig gemacht werden. Wir empfehlen, vorher alle Daten zu exportieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete payment records older than 3 years?\nThis can't be undone. We recommend exporting all data first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3年より古い決済履歴を削除しますか？\nこの操作は元に戻せません。事前に「全データをエキスポートする」をおすすめします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "3년보다 오래된 결제 기록을 삭제할까요?\n되돌릴 수 없습니다. 먼저 전체 데이터를 내보내는 것을 권장합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除 3 年以上的付款記錄？\n此操作無法撤銷。建議先匯出所有資料。"
          }
        }
      }
    },
