    "voice.input.example" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Beispiele)\n　„960 Yen, Lebensmittel“\n　„2860 Taxi“\n\nUm eine Zahlungsmethode hinzuzufügen:\n　„Methode ist VISA“\n　„Zahlungsmethode ist PayPay“\n\nZum Speichern:\n　„Speichern“ oder „OK“"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(Examples)\n　\"960 yen, groceries\"\n　\"2860 taxi\"\n\nTo add a payment method:\n　\"method is VISA\"\n　\"payment method is PayPay\"\n\nTo save:\n　\"save\" or \"OK\""
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（例）\n　“960円 食費\"\n　\"2860タクシー\"\n\n決済手段を入力する場合、\n　“決済手段は VISA”\n　“手段は PayPay”\n\n保存する場合、\n　“保存” または “OK”"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（示例）\n　“960 日元 食品”\n　“2860 出租车”\n\n要输入付款方式：\n　“方式是 VISA”\n　“付款方式是 PayPay”\n\n要保存：\n　“保存”或“好”"
          }
        }
      }
    },
