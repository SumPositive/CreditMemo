          }
        }
      }
    },
    "bank.beginner.line3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische eine Zeile nach links, um die Löschtaste einzublenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe a row left to reveal the delete button."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明細行を左へスワイプすると削除ボタンが現れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행을 왼쪽으로 밀면 삭제 버튼이 나타납니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向左滑動某行可顯示刪除按鈕。"
          }
        }
      }
    },
    "bank.beginner.statusSwipe": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische eine Zeile nach links, um das nächste Symbol einzublenden. Es zeigt den Abbuchungsstatus, gefiltert nach Konto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe a row left to reveal the next icon. It shows debit status filtered by account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明細行を左へスワイプすると次のアイコンが現れます。口座で絞った引き落とし状況を表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행을 왼쪽으로 밀면 다음 아이콘이 나타납니다. 계좌로 필터링한 출금 상태를 표시합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向左滑動某行可顯示下一個圖示。它會按賬戶篩選顯示扣款狀態。"
          }
        }
      }
    },
