    "card.beginner.addPaymentSwipeText": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Neue Zahlung“ startet einen Eintrag mit dieser Methode vorausgewählt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Payment starts a record with this method preselected"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい決済画面を開き、手段をセットします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“새 결제”는 이 수단을 미리 선택한 상태로 기록을 시작합니다"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "“新建付款”會以預選此方式開始一條記錄"
          }
        }
      }
    },
    "card.beginner.detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben rechts auf +, um eine neue Zahlungsmethode hinzuzufügen.\n\nHalte eine Zeile gedrückt und ziehe sie nach oben oder unten.\n\nWische eine Zeile nach links, um Status und Neue Zahlung einzublenden. Status zeigt nur die Abbuchungen dieser Methode; Neue Zahlung startet einen Eintrag mit dieser Methode vorausgewählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + in the top right to add a new payment method.\n\nPress and hold a row to drag it up or down.\n\nSwipe a row left to reveal Status and New Payment buttons. Status shows only this method’s debits; New Payment starts a record with this method preselected."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の＋から決済手段を追加できます\n\n明細行を押しながら上下に動かすと移動して順序を変更できます\n\n明細行を左へスワイプすると次のアイコンが現れます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 위 +에서 새 결제 수단을 추가할 수 있습니다.\n\n행을 길게 눌러 위아래로 끕니다.\n\n행을 왼쪽으로 밀면 상태와 새 결제가 나타납니다. 상태는 이 수단의 출금만 표시하고, 새 결제는 이 수단을 미리 선택해 기록을 시작합니다."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點選右上角 + 新增新的付款方式。\n\n長按某行並上下拖動。\n\n向左滑動某行可顯示“狀態”和“新建付款”。狀態僅顯示此方式的扣款；新建付款會以預選此方式開始一條記錄。"
          }
        }
      }
    },
    "card.beginner.hint": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlungsmethoden oben rechts über + hinzufügen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add payment methods from + in the top right"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の＋から決済手段を追加できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 위 +에서 결제 수단 추가"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從右上角 + 新增付款方式"
          }
        }
      }
    },
    "card.beginner.line1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe oben rechts auf +, um eine Zahlungsmethode hinzuzufügen.\n\nTippe auf eine Zeile, um sie zu bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap + at the top right to add a payment method.\n\nTap a row to edit its contents."
          }
        },
        "ja": {
