    "voice.input.example": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "(Beispiele)\n　„960 Yen, Lebensmittel“\n　„2860 Taxi“\n\nUm eine Zahlungsmethode hinzuzufügen:\n　„Methode ist VISA“\n　„Zahlungsmethode ist PayPay“\n\nZum Speichern:\n　„Speichern“ oder „OK“"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "(Examples)\n　\"960 yen, groceries\"\n　\"2860 taxi\"\n\nTo add a payment method:\n　\"method is VISA\"\n　\"payment method is PayPay\"\n\nTo save:\n　\"save\" or \"OK\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（例）\n　“960円 食費\"\n　\"2860タクシー\"\n\n決済手段を入力する場合、\n　“決済手段は VISA”\n　“手段は PayPay”\n\n保存する場合、\n　“保存” または “OK”"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "(예)\n　“960엔 식비”\n　“2860 택시”\n\n결제 수단을 입력하려면:\n　“수단은 VISA”\n　“결제 수단은 PayPay”\n\n저장하려면:\n　“저장” 또는 “확인”"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（示例）\n　“960 日元 食品”\n　“2860 計程車”\n\n要輸入付款方式：\n　“方式是 VISA”\n　“付款方式是 PayPay”\n\n要儲存：\n　“儲存”或“好”"
          }
        }
      }
    },
    "voice.input.exampleCard": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag einen Kartennamen. Tippe auf den erkannten Wert, um aus der vollständigen Liste zu wählen."
          }
        },
        "en": {
          "stringUnit": {
