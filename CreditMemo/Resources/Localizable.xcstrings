    "invoice.beginner.addPayment" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neuen Eintrag hinzufügen.\nDu kannst einen Eintrag auch durch Wischen kopieren.\nEinfach Betrag eingeben und speichern; ohne Betrag verschwindet er automatisch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a new item.\nYou can also swipe an item to copy it.\nJust enter the amount and save; if no amount is entered, it disappears automatically."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい明細を追加します\n明細をスワイプしてコピーもできます\n金額を入れて保存するだけ、金額を入れなければ自動で消えます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加新条目。\n也可滑动条目进行复制。\n只需输入金额并保存；未输入金额会自动消失。"
          }
        }
      }
    },
    "invoice.beginner.detail" : {
