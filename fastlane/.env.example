# App Store Connect API キー設定のテンプレート（CreditMemo）
# ------------------------------------------------------------
# 使い方:
#   1. このファイルを同じ場所に `.env` としてコピー
#        cp fastlane/.env.example fastlane/.env
#   2. `.env` の各値を App Store Connect で発行した実際の値に書き換える
#   3. fastlane 実行時に自動で読み込まれる（export 不要）
#        cd /Users/sumpositive/GitLocal/CreditMemo
#        fastlane preview_metadata
#
# 注意:
#   - `.env`（実ファイル）は .gitignore 済み。コミットしないこと。
#   - このテンプレ（.env.example）はプレースホルダのみなのでコミットしてOK。
#   - .p8 ファイルは fastlane/ 直下に置く前提（.gitignore 済み）。
#   - API キーのロールは `App Manager` 以上必須（Developer だと 403）。
# ------------------------------------------------------------

# API キー ID（App Store Connect > ユーザーとアクセス > 統合 > キー）
ASC_KEY_ID=ABC123DEFG

# Issuer ID（同ページ上部に表示される UUID）
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000

# ダウンロードした .p8 ファイルへのパス（fastlane/ からの相対、または絶対パス）
ASC_KEY_PATH=./fastlane/AuthKey_ABC123DEFG.p8

# （任意）App Store App ID（数字）。bundle ID だけで deliver は動くので通常は不要。
# 複数アプリで曖昧になる場合のみ設定する。
# ASC_APP_ID=1234567890
