default_platform(:ios)

# App Store Connect API キー(.p8)方式で認証する。
# 環境変数で鍵情報を渡す（README 参照）:
#   ASC_KEY_ID    … API キー ID (例: ABC123DEFG)
#   ASC_ISSUER_ID … Issuer ID (UUID)
#   ASC_KEY_PATH  … .p8 ファイルへのパス (例: ./fastlane/AuthKey_ABC123DEFG.p8)
def load_asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: ENV.fetch("ASC_KEY_PATH"),
    in_house: false
  )
end

platform :ios do
  desc "説明文・プロモーションテキストの差分を確認する（force: false なので送信前に確認プロンプトで停止）"
  lane :preview_metadata do
    load_asc_api_key
    deliver(
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_app_version_update: false,
      skip_metadata: false,
      submit_for_review: false,
      force: false,               # アップロード前に Preview.html を生成し確認を求める
      run_precheck_before_submit: false
    )
  end

  desc "説明文・プロモーションテキストを App Store Connect に反映する（審査提出はしない）"
  lane :upload_metadata do
    load_asc_api_key
    deliver(
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "App Store Connect の現在のメタデータ全体を ./fastlane/metadata へ取得する（⚠️ ローカルを上書き）"
  lane :download_metadata do
    # ⚠️ 注意: これは description / promotional_text / release_notes を含む
    #    全メタデータを ASC の現在値で「ローカル上書き」する（deliver 仕様）。
    #    せっかく翻訳したローカル版が ASC 側の古い内容で巻き戻る危険があるため、
    #    keywords.txt だけ欲しい場合はこれを使わず、ASC 画面のキーワードを手で
    #    keywords.txt に貼る方が安全（各ロケール100字以内、カンマ区切り）。
    #    どうしても全取得したいときだけ実行し、実行後に git diff で巻き戻りを確認すること。
    sh(
      "cd .. && fastlane deliver download_metadata " \
      "--key_id \"$ASC_KEY_ID\" " \
      "--issuer_id \"$ASC_ISSUER_ID\" " \
      "--key_filepath \"$ASC_KEY_PATH\" " \
      "--app_identifier com.azukid.AzCreditS1 " \
      "--metadata_path ./fastlane/metadata"
    )
  end

  # ------------------------------------------------------------
  # スクリーンショット（fastlane snapshot）
  # 前提: Xcode の UITest ターゲット CreditMemoUITests に
  #       SnapshotHelper.swift と撮影テストを紐付けておくこと。
  #       手順は fastlane/README_screenshots.md を参照。
  # ------------------------------------------------------------

  desc "シミュレータでスクショを撮影する（Snapfile の言語・デバイスに従う。アップロードはしない）"
  lane :screenshots do
    capture_screenshots   # = snapshot。設定は fastlane/Snapfile
  end

  desc "既存の ./fastlane/screenshots をそのまま App Store Connect に反映する（撮影はしない・審査提出はしない）"
  lane :upload_screenshots do
    load_asc_api_key
    # overwrite_screenshots: true = アップロード前に ASC 側の既存スクショを削除してから
    # ローカル分を上げる（＝置き換え）。これが効かず重複した原因は Deliverfile 側に
    # overwrite_screenshots(false)/skip_screenshots(true) を書いていた競合だった。
    # → Deliverfile からスクショ関連を撤去済み。ここのレーン引数だけで制御する。
    deliver(
      skip_binary_upload: true,
      skip_metadata: true,          # メタデータには触らない
      skip_screenshots: false,      # スクショだけ送る
      overwrite_screenshots: true,  # 既存スクショを削除してから置き換える
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false
    )
  end

  desc "撮影 → アップロードを一気に行う（審査提出はしない）"
  lane :screenshots_and_upload do
    capture_screenshots
    upload_screenshots
  end
end
